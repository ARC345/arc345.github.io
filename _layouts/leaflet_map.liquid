<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.title }}</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        body, html { margin: 0; padding: 0; height: 100%; width: 100%; overflow: hidden; }
        #map { height: 100%; width: 100%; }
    </style>
</head>
<body>
    <div id="map"></div>
    <script>
        var map = L.map('map').setView([20, 0], 2);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // Load Country Data
        var countriesVisited = [
            {% for trip in site.data.travel %}
                "{{ trip.country }}",
            {% endfor %}
        ];

        // Fetch World GeoJSON and apply highlighting
        fetch('https://raw.githubusercontent.com/johan/world.geo.json/master/countries.geo.json')
            .then(response => response.json())
            .then(data => {
                L.geoJSON(data, {
                    style: function(feature) {
                        if (countriesVisited.includes(feature.properties.name)) {
                            return {
                                color: '#e74c3c', // Border color (red)
                                fillColor: '#e74c3c', // Fill color (red)
                                fillOpacity: 0.2,
                                weight: 1
                            };
                        } else {
                            return {
                                color: 'transparent',
                                fillColor: 'transparent',
                                weight: 0
                            };
                        }
                    }
                }).addTo(map);
            });

        // Travel Marker Data
        var travelData = [
            {% for trip in site.data.travel %}
            {
                lat: {{ trip.latitude }},
                lng: {{ trip.longitude }},
                title: "{{ trip.location }}",
                date: "{{ trip.date }}",
                desc: "{{ trip.description }}"
            }{% unless forloop.last %},{% endunless %}
            {% endfor %}
        ];

        travelData.forEach(function(trip) {
            L.marker([trip.lat, trip.lng]).addTo(map)
                .bindPopup("<b>" + trip.title + "</b><br>" + trip.date + "<br>" + trip.desc);
        });
    </script>
</body>
</html>
